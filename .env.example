# GEMINI_API_KEY: Optional for AI studio features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign authentication tokens.
SESSION_SECRET="change_me_in_production"

# WOMPI_PUBLIC_KEY & WOMPI_INTEGRITY_SECRET: Ready for real Colombian Wompi payment gateway integration.
WOMPI_PUBLIC_KEY="pub_test_your_wompi_key"
WOMPI_INTEGRITY_SECRET="test_integrity_your_wompi_secret"

# MERCADOPAGO_ACCESS_TOKEN: Ready for real Mercado Pago Colombia integration.
MERCADOPAGO_ACCESS_TOKEN="TEST-your-mercadopago-token"
